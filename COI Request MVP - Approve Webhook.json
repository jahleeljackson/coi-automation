      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "sEMwQWzhqALeqFn2",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, request_id: $('Code - Decode PDF').item.json.request_id, draft: $json }) }}",
